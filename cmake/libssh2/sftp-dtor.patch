  * SFTP API *
  ********** */
 
+static void sftp_packet_flush(LIBSSH2_SFTP *sftp);
+
+static void sftp_handle_free(LIBSSH2_SFTP_HANDLE *handle, int shutting_down)
+{
+    LIBSSH2_SFTP *sftp = handle->sftp;
+    LIBSSH2_SESSION *session = sftp->channel->session;
+
+    ssh2_list_remove(&handle->node);
+    if(handle->handle_type == LIBSSH2_SFTP_HANDLE_DIR) {
+        if(handle->u.dir.names_left)
+            SSH2_FREE(session, handle->u.dir.names_packet);
+    }
+    else if(handle->handle_type == LIBSSH2_SFTP_HANDLE_FILE) {
+        if(handle->u.file.data)
+            SSH2_FREE(session, handle->u.file.data);
+    }
+    if(shutting_down) {
+        struct sftp_pipeline_chunk *chunk =
+            ssh2_list_first(&handle->packet_list);
+        while(chunk) {
+            struct sftp_pipeline_chunk *next = ssh2_list_next(&chunk->node);
+            ssh2_list_remove(&chunk->node);
+            SSH2_FREE(session, chunk);
+            chunk = next;
+        }
+    }
+    else
+        sftp_packetlist_flush(handle);
+    if(handle->close_packet)
+        SSH2_SAFEFREE(session, handle->close_packet);
+    SSH2_FREE(session, handle);
+}
+
 LIBSSH2_CHANNEL_CLOSE_FUNC(sftp_dtor);
 
